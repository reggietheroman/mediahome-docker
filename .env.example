MEDIAHOME_DRIVE=/mnt/external-drive
MEDIAHOME_DRIVE_DOWNLOADS=/mnt/external-drive/downloads
MEDIAHOME_DRIVE_MEDIA=/mnt/external-drive/media

# Host ports (change if another stack already uses these on the host)
# 8080 is often used by devops-hub Vaultwarden; use 8083+ on shared hosts
QBITTORRENT_PORT=8083
QBITTORRENT_BT_PORT=6881
JELLYFIN_PORT=8096
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
SEERR_PORT=5055
DOZZLE_PORT=9999
DOZZLE_ADMIN_USER=admin
DOZZLE_ADMIN_PASSWORD=change-me
BESZEL_PORT=8090
PROWLARR_PORT=9696

# FlareSolverr has no host port by default (internal only: http://flaresolverr:8191 from Prowlarr).
